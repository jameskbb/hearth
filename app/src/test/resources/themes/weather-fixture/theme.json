{
  "format": 1,
  "id": "weather-fixture",
  "name": "Weather fixture",
  "author": "Hearth tests",
  "description": "A valley that changes with the weather; images exist only as sizes in the tests",
  "dayparts": ["day"],
  "palette": { "window": "#FF102030", "accent": "#FFFFB060" },
  "motion": { "sway": { "amplitude": 8, "period": 90 } },
  "layers": [
    { "image": "sky.webp" },
    { "image": "haze.webp", "y": 200, "opacity": { "min": 0.4, "max": 0.7, "period": 60 } },
    { "image": "valley.webp", "y": 280, "parallax": 0.5 }
  ],
  "weather": [
    {
      "id": "snow",
      "when": { "sky": ["snow"], "temp": ["freezing", "cold"] },
      "palette": { "window": "#FF0C2236" },
      "replace": { "sky.webp": "sky-snow.webp" },
      "hide": ["haze.webp"],
      "add": [
        { "image": "snow-ground.webp", "y": 300, "after": "valley.webp" },
        { "image": "snowfall.webp", "wrap": true, "fall": { "y": 40, "period": 60 } }
      ]
    },
    {
      "id": "snow-coming",
      "when": { "sky": ["clear", "cloudy"], "forecast": ["snow"] },
      "add": [ { "image": "snow-clouds.webp", "after": "sky.webp", "drift": { "x": 30, "period": 120 }, "wrap": true } ]
    },
    {
      "id": "rain",
      "when": { "sky": ["rain"] },
      "palette": { "ink": "#FFF8F6F2", "shade": "#E0102030" },
      "replace": { "sky.webp": "sky-overcast.webp" },
      "add": [ { "image": "rain.webp", "fall": { "y": 120, "period": 30 } } ]
    },
    {
      "id": "overcast",
      "when": { "sky": ["cloudy"], "forecast": ["none"] },
      "replace": { "sky.webp": "sky-overcast.webp" }
    },
    {
      "id": "hot",
      "when": { "sky": ["clear"], "temp": ["hot"] },
      "palette": { "window": "#FF2A1A10" },
      "add": [ { "image": "heat-haze.webp", "y": 180 } ]
    }
  ]
}
