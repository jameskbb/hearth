{
  "format": 1,
  "id": "halloween",
  "name": "Halloween",
  "author": "Hearth",
  "description": "Friendly carved pumpkins beside a corn maze and softly breathing string lights",
  "autoRotationEligible": false,
  "dayparts": [],
  "palette": {
    "ink": "#FFFFF2DF",
    "inkMuted": "#E6FFF2DF",
    "accent": "#FFF2B56F",
    "glow": "#66EBA15A",
    "shade": "#E00C1B24",
    "shadeMid": "#730C1B24",
    "window": "#FF0C1B24"
  },
  "preview": "preview.webp",
  "layers": [
    {
      "image": "sky.webp"
    },
    {
      "image": "maze.webp",
      "y": 140
    },
    {
      "image": "lights.webp",
      "y": 130,
      "opacity": {
        "min": 0.46,
        "max": 0.66,
        "period": 180,
        "phase": 0
      }
    }
  ],
  "weather": [
    {
      "id": "fog",
      "when": {
        "sky": [
          "fog"
        ]
      },
      "add": [
        {
          "image": "moon-halo.webp",
          "after": "sky.webp"
        },
        {
          "image": "fog-far.webp",
          "y": 210,
          "after": "sky.webp"
        },
        {
          "image": "fog-near.webp",
          "y": 290,
          "after": "maze.webp"
        }
      ]
    },
    {
      "id": "rain",
      "when": {
        "sky": [
          "rain"
        ]
      },
      "add": [
        {
          "image": "veil-overcast.webp",
          "after": "sky.webp"
        },
        {
          "image": "wet.webp",
          "y": 230,
          "after": "maze.webp"
        },
        {
          "image": "rain.webp",
          "wrap": true,
          "fall": {
            "y": 120,
            "period": 30
          }
        }
      ]
    },
    {
      "id": "overcast",
      "when": {
        "sky": [
          "cloudy"
        ]
      },
      "add": [
        {
          "image": "veil-overcast.webp",
          "after": "sky.webp"
        }
      ]
    }
  ]
}
