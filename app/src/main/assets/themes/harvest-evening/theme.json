{
  "format": 1,
  "id": "harvest-evening",
  "name": "Harvest Evening",
  "author": "Hearth",
  "description": "Copper leaves and pumpkins in the last autumn light",
  "autoRotationEligible": false,
  "dayparts": [],
  "palette": {
    "ink": "#FFFFF2DF",
    "inkMuted": "#E6FFF2DF",
    "accent": "#FFF2B56F",
    "glow": "#66EBA15A",
    "shade": "#E0152027",
    "shadeMid": "#73152027",
    "window": "#FF152027"
  },
  "preview": "preview.webp",
  "layers": [
    {
      "image": "sky.webp"
    },
    {
      "image": "clouds.webp",
      "y": 124,
      "wrap": true,
      "drift": {
        "x": 64,
        "period": 180
      }
    },
    {
      "image": "orchard.webp",
      "y": 202
    }
  ],
  "weather": [
    {
      "id": "frost",
      "when": {
        "sky": [
          "clear"
        ],
        "temp": [
          "freezing"
        ]
      },
      "add": [
        {
          "image": "sky-crisp.webp",
          "after": "sky.webp"
        },
        {
          "image": "frost.webp",
          "y": 300
        }
      ]
    },
    {
      "id": "fog",
      "when": {
        "sky": [
          "fog"
        ]
      },
      "replace": {
        "clouds.webp": "clouds-overcast.webp"
      },
      "add": [
        {
          "image": "fog-far.webp",
          "y": 220,
          "after": "clouds.webp"
        },
        {
          "image": "fog-near.webp",
          "y": 300
        }
      ]
    },
    {
      "id": "rain",
      "when": {
        "sky": [
          "rain"
        ]
      },
      "replace": {
        "clouds.webp": "clouds-overcast.webp"
      },
      "add": [
        {
          "image": "veil-overcast.webp",
          "after": "sky.webp"
        },
        {
          "image": "wet.webp",
          "y": 300
        },
        {
          "image": "rain.webp",
          "wrap": true,
          "fall": {
            "y": 120,
            "period": 30
          }
        }
      ]
    },
    {
      "id": "overcast",
      "when": {
        "sky": [
          "cloudy"
        ]
      },
      "replace": {
        "clouds.webp": "clouds-overcast.webp"
      },
      "add": [
        {
          "image": "veil-overcast.webp",
          "after": "sky.webp"
        }
      ]
    }
  ]
}
