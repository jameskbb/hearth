<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A TV launcher: no touchscreen required, leanback declared but not required so the
         same APK also runs on the emulator and on Fire OS. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Used only by opt-in weather, which is off by default: requests go only to Open-Meteo, over
         HTTPS, and only after the user turns weather on in Settings
         (docs/decisions/0005-opt-in-weather.md). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (Android 11+): see only launchable apps, not every package. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets the settings route resolve on Android 11+, so it is not wrongly hidden. -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- TV inputs: the passthrough channel ACTION_VIEW that shows an HDMI input, and the TV
             provider that reports that URI's type, so the route resolves on Android 11+ too
             (docs/decisions/0007-tv-inputs.md). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/channel" />
        </intent>
        <provider android:authorities="android.media.tv" />
    </queries>

    <application
        android:name=".HearthApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hearth"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets Android list Hearth as a home app where the platform allows choosing one. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
