{
  "format": 1,
  "id": "new-year",
  "name": "New Year",
  "author": "Hearth",
  "description": "Champagne lights above a quiet midnight lake",
  "autoRotationEligible": false,
  "dayparts": [],
  "palette": {
    "ink": "#FFFFF4DF",
    "inkMuted": "#CCFFF4DF",
    "accent": "#FFE4C38C",
    "glow": "#66E4C38C",
    "shade": "#E0081526",
    "shadeMid": "#73081526",
    "window": "#FF081526"
  },
  "preview": "preview.webp",
  "layers": [
    {
      "image": "lakeside.webp"
    },
    {
      "image": "haze.webp",
      "y": 145,
      "wrap": true,
      "drift": {
        "x": 54,
        "period": 180
      }
    },
    {
      "image": "reflections.webp",
      "y": 318,
      "drift": {
        "x": 4,
        "period": 64
      },
      "opacity": {
        "min": 0.64,
        "max": 0.9,
        "period": 90
      }
    }
  ],
  "weather": [
    {
      "id": "freezing-clear",
      "when": {
        "sky": [
          "clear"
        ],
        "temp": [
          "freezing"
        ]
      },
      "add": [
        {
          "image": "sky-crisp.webp",
          "after": "lakeside.webp"
        },
        {
          "image": "stars.webp",
          "after": "lakeside.webp"
        },
        {
          "image": "frost.webp",
          "y": 300
        }
      ]
    },
    {
      "id": "snow",
      "when": {
        "sky": [
          "snow"
        ]
      },
      "add": [
        {
          "image": "veil-overcast.webp",
          "after": "lakeside.webp"
        },
        {
          "image": "bursts.webp",
          "y": 100,
          "after": "lakeside.webp"
        },
        {
          "image": "snow-shore.webp",
          "y": 340,
          "after": "reflections.webp"
        },
        {
          "image": "snowfall-far.webp",
          "wrap": true,
          "fall": {
            "y": 60,
            "period": 60
          }
        },
        {
          "image": "snowfall-near.webp",
          "wrap": true,
          "fall": {
            "y": 100,
            "period": 60
          }
        }
      ]
    },
    {
      "id": "overcast",
      "when": {
        "sky": [
          "cloudy"
        ]
      },
      "add": [
        {
          "image": "veil-overcast.webp",
          "after": "lakeside.webp"
        },
        {
          "image": "bursts.webp",
          "y": 100,
          "after": "lakeside.webp"
        }
      ]
    }
  ]
}
